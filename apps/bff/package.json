{
  "name": "@playground/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @playground/mock-issuer --filter @playground/mock-verifier build && vitest run"
  },
  "dependencies": {
    "@digitalbazaar/ed25519-signature-2020": "5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "4.2.0",
    "@playground/mock-issuer": "workspace:*",
    "@playground/mock-verifier": "workspace:*",
    "@playground/shared": "workspace:*",
    "@prisma/client": "6.19.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "jose": "6.2.13",
    "jsonld": "9.0.0",
    "jsonld-signatures": "11.6.0",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@vitest/coverage-v8": "3.2.4",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
