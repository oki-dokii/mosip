{
  "name": "@playground/mock-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.13",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  }
}
