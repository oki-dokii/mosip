{
  "name": "inji-interoperability-playground",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "pnpm --filter @playground/bff db:generate",
    "dev": "pnpm --parallel --filter @playground/bff --filter @playground/web --filter @playground/mock-issuer --filter @playground/mock-verifier dev",
    "dev:x509-mock": "bash scripts/dev-x509-mock.sh",
    "mobile:inji": "node scripts/mobile-inji.mjs",
    "demo:inji": "bash scripts/demo-inji-local.sh",
    "probe:inji": "node scripts/local-inji-smoke.mjs --matrix",
    "demo:docker": "bash scripts/demo-docker.sh",
    "e2e:smoke": "node e2e/smoke.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "capture:filter": "pnpm --filter @playground/bff exec tsx src/capture/filter.ts",
    "capture:bridge": "pnpm --filter @playground/bff exec tsx src/capture/live-bridge-cli.ts",
    "capture:routes": "pnpm --filter @playground/bff exec tsx src/capture/live-bridge-cli.ts --routes",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @playground/bff db:generate",
    "db:migrate": "pnpm --filter @playground/bff db:migrate",
    "db:deploy": "pnpm --filter @playground/bff db:deploy",
    "typecheck": "pnpm --filter @playground/shared --filter @playground/mock-issuer --filter @playground/mock-verifier build && pnpm -r typecheck",
    "test": "pnpm --filter @playground/shared --filter @playground/mock-issuer --filter @playground/mock-verifier build && node --test spikes/*.test.mjs scripts/*.test.mjs && pnpm -r test",
    "spike:contracts": "node spikes/collab-contract-spike.mjs",
    "spike:wallet": "node spikes/collab-reference-wallet.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@digitalbazaar/ed25519-signature-2020": "5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "4.2.0",
    "jose": "6.2.13",
    "jsonld": "9.0.0",
    "jsonld-signatures": "11.6.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
