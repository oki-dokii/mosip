{
  "name": "inji-interoperability-playground",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "pnpm --filter @playground/bff db:generate",
    "dev": "pnpm --parallel --filter @playground/bff --filter @playground/web --filter @playground/mock-issuer --filter @playground/mock-verifier dev",
    "dev:x509-mock": "bash scripts/dev-x509-mock.sh",
    "demo:docker": "bash scripts/demo-docker.sh",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @playground/bff db:generate",
    "db:migrate": "pnpm --filter @playground/bff db:migrate",
    "db:deploy": "pnpm --filter @playground/bff db:deploy",
    "typecheck": "pnpm --filter @playground/shared build && pnpm -r typecheck",
    "test": "node --test spikes/*.test.mjs && pnpm -r test",
    "spike:contracts": "node spikes/collab-contract-spike.mjs",
    "spike:wallet": "node spikes/collab-reference-wallet.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@digitalbazaar/ed25519-signature-2020": "5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "4.2.0",
    "jose": "6.2.13",
    "jsonld": "9.0.0",
    "jsonld-signatures": "11.6.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
