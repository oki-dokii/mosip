DATABASE_URL=postgresql://playground:playground@127.0.0.1:55433/playground?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:5173
PLAYGROUND_DRIVER_MODE=fixture
# Required only when PLAYGROUND_DRIVER_MODE=collab
OFFICIAL_POSTMAN_ENV_PATH=/absolute/path/to/inji-certify-with-mock-identity.postman_environment.json
MOCK_OTP=replace-with-official-public-mock-otp
# Optional Collab endpoint/configuration overrides
# ESIGNET_BASE_URL=https://esignet-mock.collab.mosip.net/v1/esignet
# CERTIFY_BASE_URL=https://injicertify-farmer.collab.mosip.net
# VERIFY_BASE_URL=https://injiverify.collab.mosip.net/v1/verify
# Set this to use the separate local OpenID4VCI test issuer (started by pnpm dev).
# MOCK_ISSUER_BASE_URL=http://127.0.0.1:4101
# MOCK_ISSUER_PORT=4101
# MOCK_ISSUER_VERSION_LABEL=mock-x509-1
# Optional X.509 signing mode for the standalone test issuer. Provide a matching HTTPS issuer ID.
# Keep the private key outside the repository; pnpm dev:x509-mock generates an ephemeral pair instead.
# MOCK_ISSUER_SIGNING_KEY_PATH=/absolute/path/to/test-key.pem
# MOCK_ISSUER_CERT_CHAIN_PATH=/absolute/path/to/test-chain.pem
# MOCK_ISSUER_ISSUER_ID=https://mock-issuer.example.org
# Set this to use the separate local OpenID4VP test verifier (started by pnpm dev).
# MOCK_VERIFIER_BASE_URL=http://127.0.0.1:4102
# MOCK_VERIFIER_PORT=4102
# VERIFY_POLL_INTERVAL_MS=1000
# VERIFY_POLL_TIMEOUT_MS=120000
# Assisted live capture bridge: set the same fresh, private authorization token in
# the local BFF process and collector shell. It is NOT the run-correlation HMAC key.
# CAPTURE_BRIDGE_TOKEN=
# ASSISTED_LIVE_ENABLED=true
# ASSISTED_WALLET_URL=https://injiweb.collab.mosip.net
# Public Land Registry issuer page observed 24 Oct; selecting/issuing still needs a signed-in live check.
# ASSISTED_OFFER_URL=https://injiweb.collab.mosip.net/issuers/Land
# ASSISTED_PRESENTATION_URL_TEMPLATE=https://injiweb.collab.mosip.net/user/authorize?client_id=YOUR_VERIFIER_CLIENT_ID&request_uri={request_uri}
# Set this to the tested public JSON-LD type URIs for Land Registry rather than
# using the default Farmer request. Do not guess the deployed credential types.
# Hosted Land Registry request type observed by Person 2 (enable only for that profile):
# VERIFY_LDP_TYPE_VALUES_JSON=["https://www.w3.org/ns/credentials#VerifiableCredential","https://inji.github.io/inji-config/contexts/landregistry-registration-receipt-context.json#RegistrationReceiptCredential"]
# CREDENTIAL_CONFIGURATION_ID=FarmerCredential_VCDM2.0
# CREDENTIAL_SCOPE=mock_identity_vc_ldp
# Optional release labels for regression history; use your deployment's real version/tag.
# CERTIFY_VERSION_LABEL=unreported
# VERIFY_VERSION_LABEL=unreported
# Opt in on both BFF and external mock issuer for signed expiry/type test grants.
# MOCK_ISSUER_ENABLE_TEST_CASES=true
